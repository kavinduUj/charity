<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="7dp"
    app:cardCornerRadius="10dp"
    android:elevation="2dp"
    app:cardMaxElevation="2dp"
    app:cardElevation="2dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="marquee"
            android:id="@+id/title"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="5dp">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:id="@+id/location"
                android:textSize="12sp"
                android:gravity="center|start"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:drawablePadding="5dp"
                app:drawableStartCompat="@drawable/baseline_location_pin_15"
                app:drawableTint="#878787" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_height="wrap_content"
                android:id="@+id/date"
                android:textSize="12sp"
                android:gravity="center|start"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:drawablePadding="5dp"
                app:drawableStartCompat="@drawable/baseline_calendar_month_15"
                app:drawableTint="#878787" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="20dp"
                android:layout_margin="10dp"
                app:cardElevation="0dp">
                <ImageView
                    android:src="@drawable/event_cover"
                    android:scaleType="centerCrop"
                    android:id="@+id/coverImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                </ImageView>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:id="@+id/attendImg"
                android:gravity="end">
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:padding="12dp"
                    android:layout_marginEnd="25dp"
                    android:background="@drawable/circle_default_white"
                    android:src="@drawable/baseline_back_hand_24"
                    app:tint="@color/green" />
            </LinearLayout>
        </FrameLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textSize="12sp"
            android:id="@+id/des"
            android:ellipsize="marquee"
            android:textColor="#5B5B5B"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>